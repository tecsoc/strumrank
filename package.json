{
  "name": "strumrank",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4",
    "pnpm": "10.23.0"
  },
  "packageManager": "pnpm@10.23.0",
  "volta": {
    "node": "22.23.4"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply strumrank --local",
    "db:migrate:remote": "wrangler d1 migrations apply strumrank --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@fontsource/dela-gothic-one": "5.3.0",
    "@fontsource/zen-kaku-gothic-new": "5.3.0",
    "@hono/zod-validator": "0.9.1",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.41",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vite-plugin": "1.62.4",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.42",
    "@types/babel__core": "7.20.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "4.1.12",
    "wrangler": "4.146.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "undici@>=7.0.0 <7.29.1": "7.30.0",
      "sharp@<0.35.5": "0.35.5",
      "esbuild@<0.25.0": "0.28.2"
    }
  }
}
