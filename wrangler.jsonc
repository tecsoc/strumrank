{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strumrank",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-02",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "strumrank",
      "database_id": "304a97dc-c7c9-4d01-98f5-ce79c3a0cb3b",
      "migrations_dir": "drizzle"
    }
  ],
  // MusicBrainz での名寄せを1分1件ずつ処理する（1req/s の上限を守るため直列化）
  "triggers": { "crons": ["* * * * *"] },
  // IP ごとの回数制限。namespace_id はアカウント内で一意な整数
  "ratelimits": [
    { "name": "REGISTER_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "VOTE_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "LIKE_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    { "name": "SEARCH_LIMITER", "namespace_id": "1004", "simple": { "limit": 120, "period": 60 } },
    { "name": "READ_LIMITER", "namespace_id": "1005", "simple": { "limit": 300, "period": 60 } },
    { "name": "SESSION_LIMITER", "namespace_id": "1006", "simple": { "limit": 20, "period": 60 } }
  ],
  // Turnstile の本番サイトキー（公開値）と、確認を受け付けるホスト名。
  // ローカルでは .dev.vars のテストキーが優先される。シークレットは `wrangler secret put` で登録する
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFYdj0zb3ShxyvOL",
    "TURNSTILE_HOSTNAME": "strumrank.tecsoc.workers.dev"
  },
  "observability": { "enabled": true }
}
